@page "/chess"
@using ChessMate.Models
@using ChessMate.Services
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.Extensions.Configuration
@inject IChessBoard Board
@inject IStateService State
@inject IMoveService MoveService
@inject IConfiguration Configuration
@inject NavigationManager NavigationManager

<h3>Chess Game</h3>

<div class="chess-container">
    <!-- Chessboard Section -->
    <div class="chess-board">
        <table class="chessboard">
            <thead>
                <tr>
                    <th></th>
                    @for (char col = 'a'; col <= 'h'; col++)
                    {
                        <th>@col</th>
                    }
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @for (int row = 0; row < 8; row++)
            {
                int currentRow = row; // Capture row locally
                <tr>
                    <th>@(8 - currentRow)</th> <!-- Row label (8, 7, 6, ...) -->
                    @for (int col = 0; col < 8; col++)
                    {
                        int currentCol = col; // Capture col locally
                        var position = new Position(currentRow, currentCol);
                        var piece = Board.GetPieceAt(position);
                        var whiteAttackers = State.GetWhiteAttackers(position);
                        var blackAttackers = State.GetBlackAttackers(position);

                        <td @onclick="() => SelectSquare(position)"
                            class="@GetSquareCssClass(position)">
                            @if (piece != null)
                            {
                                <span class="piece">@piece.Representation</span>
                            }
                        </td>
                    }
                    <th>@(8 - currentRow)</th> <!-- Row label on the other side -->
                </tr>
            }
            </tbody>
            <tfoot>
                <tr>
                    <th></th>
                    @for (char col = 'a'; col <= 'h'; col++)
                    {
                        <th>@col</th>
                    }
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- Selected Square Attackers Section -->
    @if (selectedPosition.HasValue)
    {
        <div class="attackers-info">
            <h4>Attackers for @selectedPosition.Value.ToChessNotation()</h4>
            <div class="attackers-list">
                @if (isSelectedUnderAttackByWhite || isSelectedUnderAttackByBlack)
                {
                    @if (isSelectedUnderAttackByWhite)
                    {
                        <div class="attackers white">
                            <h5>White Attackers:</h5>
                            @foreach (var attacker in selectedWhiteAttackers)
                            {
                                <span class="attacker">@attacker.Representation (@attacker.GetType().Name)</span>
                                <br />
                            }
                        </div>
                    }
                    @if (isSelectedUnderAttackByBlack)
                    {
                        <div class="attackers black">
                            <h5>Black Attackers:</h5>
                            @foreach (var attacker in selectedBlackAttackers)
                            {
                                <span class="attacker">@attacker.Representation (@attacker.GetType().Name)</span>
                                <br />
                            }
                        </div>
                    }
                }
                else
                {
                    <p>No attackers on this square.</p>
                }
            </div>
        </div>
    }

    <!-- Game Information Section -->
    <div class="game-info">
        <h3>Game Info</h3>
        <p><strong>Current Player:</strong> @State.CurrentPlayer</p>
        <p><strong>Check:</strong> @(State.IsCheck ? "Yes" : "No")</p>
        <p><strong>Checkmate:</strong> @(State.IsCheckmate ? "Yes" : "No")</p>
        <p><strong>En Passant Target:</strong> @(State.EnPassantTarget?.ToChessNotation() ?? "None")</p>
    </div>

    <!-- Move Log Section -->
    <div class="move-log">
        <h3>Move Log</h3>
        <ul>
            @foreach (var move in State.MoveLog)
            {
                <li>@move</li>
            }
        </ul>
    </div>

    <!-- Captured Pieces Section -->
    <div class="captured-pieces">
        <h3>Captured Pieces</h3>
        <div class="captures white-captures">
            <h4>White Captures:</h4>
            @foreach (var piece in State.CapturedPieces.Where(p => p.Color == "Black"))
            {
                <span class="captured-piece">@piece.Representation</span>
            }
        </div>
        <div class="captures black-captures">
            <h4>Black Captures:</h4>
            @foreach (var piece in State.CapturedPieces.Where(p => p.Color == "White"))
            {
                <span class="captured-piece">@piece.Representation</span>
            }
        </div>
    </div>
</div>

<!-- Error Message Display -->
@if (!string.IsNullOrEmpty(errorMessage))
{
    <p class="error-message">@errorMessage</p>
}

@code {
    private string? errorMessage;
    private Position? selectedPosition;
    private List<ChessPiece> selectedWhiteAttackers = new();
    private List<ChessPiece> selectedBlackAttackers = new();
    private bool isSelectedUnderAttackByWhite = false;
    private bool isSelectedUnderAttackByBlack = false;

    // Collection to store highlighted positions and their types
    private List<Position> highlightedPositions = new();
    private Dictionary<Position, HighlightType> highlightedMoveTypes = new();

    private bool EnableMultiplayer => Configuration.GetValue<bool>("GameSettings:EnableMultiplayer");
    private HubConnection? hubConnection;

    private enum HighlightType
    {
        Valid,
        Capture
    }

    protected override async Task OnInitializedAsync()
    {
        if (EnableMultiplayer)
        {
            // Initialize SignalR connection
            hubConnection = new HubConnectionBuilder()
                .WithUrl(NavigationManager.ToAbsoluteUri("/chesshub"))
                .Build();

            hubConnection.On<string, string>("ReceiveMove", async (start, end) =>
            {
                var from = new Position(start);
                var to = new Position(end);
                bool moveSuccess = MoveService.TryMove(from, to);
                if (moveSuccess)
                {
                    // Optionally, handle post-move actions
                }
                else
                {
                    errorMessage = "Received an invalid move.";
                }
                await InvokeAsync(StateHasChanged);
            });

            await hubConnection.StartAsync();
        }
    }

    private async Task SelectSquare(Position position)
    {
        if (selectedPosition == null)
        {
            // Select the first square
            var piece = Board.GetPieceAt(position);
            if (piece != null && piece.Color == State.CurrentPlayer)
            {
                selectedPosition = position;
                UpdateSelectedAttackers(position);
                HighlightPossibleMoves(piece);
            }
            else
            {
                errorMessage = "Please select one of your own pieces.";
            }
        }
        else
        {
            var from = selectedPosition.Value;
            var to = position;

            if (from.Equals(to))
            {
                // Deselect if the same square is clicked
                selectedPosition = null;
                ClearSelectedAttackers();
                ClearHighlights();
                errorMessage = null;
                await InvokeAsync(StateHasChanged);
                return;
            }

            // Check if the clicked square is a highlighted move
            if (highlightedPositions.Contains(to))
            {
                bool success = MoveService.TryMove(from, to);
                if (!success)
                {
                    errorMessage = "Invalid move. Please try again.";
                }
                else
                {
                    errorMessage = null;

                    // If multiplayer is enabled, send the move via SignalR
                    if (EnableMultiplayer && hubConnection != null)
                    {
                        await hubConnection.SendAsync("SendMove", from.ToChessNotation(), to.ToChessNotation());
                    }
                }

                selectedPosition = null;
                ClearSelectedAttackers();
                ClearHighlights();

                await InvokeAsync(StateHasChanged);
                return;
            }
            else
            {
                errorMessage = "Please select a highlighted valid move.";
            }
        }
    }

    /// <summary>
    /// Highlights possible moves for the selected piece.
    /// </summary>
    private void HighlightPossibleMoves(ChessPiece piece)
    {
        ClearHighlights();

        var possibleMoves = State.GetPossibleMoves(piece); // Assumes this method exists and is public

        foreach (var move in possibleMoves)
        {
            var targetPiece = Board.GetPieceAt(move);
            if (targetPiece != null && targetPiece.Color != piece.Color)
            {
                highlightedMoveTypes[move] = HighlightType.Capture;
            }
            else
            {
                highlightedMoveTypes[move] = HighlightType.Valid;
            }
            highlightedPositions.Add(move);
        }
    }

    /// <summary>
    /// Clears all highlighted positions.
    /// </summary>
    private void ClearHighlights()
    {
        highlightedPositions.Clear();
        highlightedMoveTypes.Clear();
    }

    /// <summary>
    /// Updates the attackers information for the selected square.
    /// </summary>
    private void UpdateSelectedAttackers(Position position)
    {
        selectedWhiteAttackers = State.GetWhiteAttackers(position);
        selectedBlackAttackers = State.GetBlackAttackers(position);
        isSelectedUnderAttackByWhite = selectedWhiteAttackers.Any();
        isSelectedUnderAttackByBlack = selectedBlackAttackers.Any();
    }

    /// <summary>
    /// Clears the attackers information when deselecting a square.
    /// </summary>
    private void ClearSelectedAttackers()
    {
        selectedWhiteAttackers.Clear();
        selectedBlackAttackers.Clear();
        isSelectedUnderAttackByWhite = false;
        isSelectedUnderAttackByBlack = false;
    }

    /// <summary>
    /// Determines the CSS classes for each square based on position and highlights.
    /// </summary>
    private string GetSquareCssClass(Position position)
    {
        string baseClass = (position.Row + position.Col) % 2 == 0 ? "light" : "dark";
        string selectedClass = selectedPosition.HasValue && selectedPosition.Value.Equals(position) ? " selected" : "";
        string highlightClass = "";

        if (highlightedPositions.Contains(position))
        {
            highlightClass = highlightedMoveTypes[position] == HighlightType.Capture ? " highlight-capture" : " highlight-valid";
        }

        return $"{baseClass}{selectedClass}{highlightClass}";
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
