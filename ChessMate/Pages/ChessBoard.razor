@page "/chess"
@using ChessMate.Models
@using ChessMate.Services
@using ChessMate.Utilities
@inject IChessBoard Board
@inject IStateService State
@inject IGameEngine GameEngine

<h3>Chess Game</h3>

<div class="chess-container">
    <!-- Chessboard Section -->
    <div class="chess-board">
        <table class="chessboard">
            <thead>
                <tr>
                    <th></th>
                    @for (char col = 'a'; col <= 'h'; col++)
                    {
                        <th>@col</th>
                    }
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @for (int row = 0; row < 8; row++)
                {
                    <tr>
                        <th>@(8 - row)</th>
                        @for (int col = 0; col < 8; col++)
                        {
                            var position = new Position(row, col);
                            var piece = Board.GetPieceAt(position);
                            var whiteAttackers = State.GetWhiteAttackers(position);
                            var blackAttackers = State.GetBlackAttackers(position);

                            <td @onclick="() => SelectSquare(position)"
                                class="@GetSquareCssClass(position)">
                                @if (piece != null)
                                {
                                    <span class="piece">@piece.Representation</span>
                                }
                            </td>
                        }
                        <th>@(8 - row)</th>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th></th>
                    @for (char col = 'a'; col <= 'h'; col++)
                    {
                        <th>@col</th>
                    }
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- Selected Square Attackers Section -->
    @if (selectedPosition.HasValue)
    {
        <div class="attackers-info">
            <h4>Attackers for @selectedPosition.Value.ToChessNotation()</h4>
            <div class="attackers-list">
                @if (isSelectedUnderAttackByWhite || isSelectedUnderAttackByBlack)
                {
                    @if (isSelectedUnderAttackByWhite)
                    {
                        <div class="attackers white">
                            <h5>White Attackers:</h5>
                            @foreach (var attacker in selectedWhiteAttackers)
                            {
                                <span class="attacker">@attacker.Representation (@attacker.GetType().Name)</span>
                                <br />
                            }
                        </div>
                    }
                    @if (isSelectedUnderAttackByBlack)
                    {
                        <div class="attackers black">
                            <h5>Black Attackers:</h5>
                            @foreach (var attacker in selectedBlackAttackers)
                            {
                                <span class="attacker">@attacker.Representation (@attacker.GetType().Name)</span>
                                <br />
                            }
                        </div>
                    }
                }
                else
                {
                    <p>No attackers on this square.</p>
                }
            </div>
        </div>
    }

    <!-- Game Information Section -->
    <div class="game-info">
        <h3>Game Info</h3>
        <p><strong>Current Player:</strong> @State.CurrentPlayer</p>
        <p><strong>Check:</strong> @(State.IsCheck ? "Yes" : "No")</p>
        <p><strong>Checkmate:</strong> @(State.IsCheckmate ? "Yes" : "No")</p>
        <p><strong>En Passant Target:</strong> @(State.EnPassantTarget?.ToChessNotation() ?? "None")</p>
    </div>

    <!-- Move Log Section -->
    <div class="move-log">
        <h3>Move Log</h3>
        <ul>
            @foreach (var move in State.MoveLog)
            {
                <li>@move</li>
            }
        </ul>
    </div>

    <!-- Captured Pieces Section -->
    <div class="captured-pieces">
        <h3>Captured Pieces</h3>
        <div class="captures white-captures">
            <h4>White Captures:</h4>
            @foreach (var piece in State.CapturedPieces.Where(p => p.Color == "Black"))
            {
                <span class="captured-piece">@piece.Representation</span>
            }
        </div>
        <div class="captures black-captures">
            <h4>Black Captures:</h4>
            @foreach (var piece in State.CapturedPieces.Where(p => p.Color == "White"))
            {
                <span class="captured-piece">@piece.Representation</span>
            }
        </div>
    </div>
</div>

<!-- Error Message Display -->
@if (!string.IsNullOrEmpty(errorMessage))
{
    <p class="error-message">@errorMessage</p>
}

@code {
    private string? errorMessage;
    private Position? selectedPosition;
    private List<ChessPiece> selectedWhiteAttackers = new();
    private List<ChessPiece> selectedBlackAttackers = new();
    private bool isSelectedUnderAttackByWhite = false;
    private bool isSelectedUnderAttackByBlack = false;

    /// <summary>
    /// Handles the selection of a chessboard square.
    /// </summary>
    private void SelectSquare(Position position)
    {
        if (selectedPosition == null)
        {
            // Select the first square
            var piece = Board.GetPieceAt(position);
            if (piece != null && piece.Color == State.CurrentPlayer)
            {
                selectedPosition = position;
                UpdateSelectedAttackers(position);
            }
            else
            {
                errorMessage = "Please select one of your own pieces.";
            }
        }
        else
        {
            var from = selectedPosition.Value;
            var to = position;

            if (from.Equals(to))
            {
                // Deselect if the same square is clicked
                selectedPosition = null;
                ClearSelectedAttackers();
                errorMessage = null;
                return;
            }

            bool success = GameEngine.ProcessMove(from, to);
            if (!success)
            {
                errorMessage = "Invalid move. Please try again.";
            }
            else
            {
                errorMessage = null;
            }
            selectedPosition = null;
            ClearSelectedAttackers();
        }
    }

    /// <summary>
    /// Updates the attackers information for the selected square.
    /// </summary>
    private void UpdateSelectedAttackers(Position position)
    {
        selectedWhiteAttackers = State.GetWhiteAttackers(position);
        selectedBlackAttackers = State.GetBlackAttackers(position);
        isSelectedUnderAttackByWhite = selectedWhiteAttackers.Any();
        isSelectedUnderAttackByBlack = selectedBlackAttackers.Any();
    }

    /// <summary>
    /// Clears the attackers information when deselecting a square.
    /// </summary>
    private void ClearSelectedAttackers()
    {
        selectedWhiteAttackers.Clear();
        selectedBlackAttackers.Clear();
        isSelectedUnderAttackByWhite = false;
        isSelectedUnderAttackByBlack = false;
    }

    /// <summary>
    /// Determines the CSS classes for each square based on position.
    /// </summary>
    private string GetSquareCssClass(Position position)
    {
        string baseClass = (position.Row + position.Col) % 2 == 0 ? "light" : "dark";
        string selectedClass = "";

        if (selectedPosition.HasValue && selectedPosition.Value.Equals(position))
        {
            selectedClass = " selected";
        }

        return $"{baseClass}{selectedClass}";
    }
}
